{
  "name": "undelete",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k 'node --watch server/index.mjs' 'vite --host 127.0.0.1'",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "companion": "node companion/index.mjs",
    "check": "npm test && npm run build",
    "docs": "node deploy/generate-docs.mjs",
    "package:companion": "npm run docs && node deploy/package-companion.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@whiskeysockets/baileys": "^6.7.21",
    "diff": "^8.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pino": "^9.9.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "teleproto": "^1.229.0",
    "ws": "8.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "vite": "^7.1.0"
