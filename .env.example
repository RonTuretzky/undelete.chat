PORT=4318
DATA_DIR=./data
# Set a unique 32-byte key (64 hex characters); back it up separately from the database.
ARCHIVE_KEY=
PUBLIC_ORIGIN=http://localhost:4318
# Leave empty for open signup (the default). Set a code only to close signups for a private beta.
INVITE_CODE=
NODE_ENV=development
# Hosted collectors run independently of the user's computer.
HOSTED_COLLECTORS=false
HOSTED_MAX_COLLECTORS=4
# Application credentials configured once by the operator, never by customers.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Signal working files must be on tmpfs in production.
COLLECTOR_RUNTIME_DIR=/tmp/afterword-collectors
# Optional off-server encrypted backups. Configure all four together.
# Use a private dedicated Spaces bucket and a key limited to that bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Optional subscription billing through Stripe. Leave empty to run without
# billing; every account is then entitled. Configure all three together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Free trial length for new workspaces, and operator usernames that never lapse.
BILLING_TRIAL_DAYS=14
BILLING_EXEMPT_USERS=owner
# Shown on the landing page and plan card, e.g. $5. Keep it in step with the Stripe price.
BILLING_PRICE_LABEL=
