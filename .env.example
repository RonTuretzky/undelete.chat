PORT=4318
DATA_DIR=./data
# Set a unique 32-byte key (64 hex characters); back it up separately from the database.
ARCHIVE_KEY=
PUBLIC_ORIGIN=http://localhost:4318
# Leave empty for open signup locally. Set an invite code for a private beta.
INVITE_CODE=
NODE_ENV=development
# Hosted collectors run independently of the user's computer.
HOSTED_COLLECTORS=false
HOSTED_MAX_COLLECTORS=4
# Application credentials configured once by the operator, never by customers.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Signal working files must be on tmpfs in production.
COLLECTOR_RUNTIME_DIR=/tmp/afterword-collectors
