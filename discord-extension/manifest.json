{
  "manifest_version": 3,
  "name": "Afterword — Personal Discord Archive",
  "version": "0.3.0",
  "description": "Save DM revisions delivered to your own Discord Web tab. Experimental personal message archiving.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "storage", "alarms"],
  "host_permissions": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Afterword", "default_popup": "popup.html" },
  "options_page": "popup.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
